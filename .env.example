# ─── Arena credentials ────────────────────────────────────────────────────────
# Leave blank — agent.py auto-registers and writes .arena-credentials on first run.
ARENA_API_KEY=

# API base (default shown — don't change)
ARENA_API_BASE=https://arena.dev.fun/api/arena

# ─── Competition ID ────────────────────────────────────────────────────────────
# 500-hand quick test (default) — ~15 min
ARENA_COMPETITION_ID=seed_poker_eval_s1

# 5000-hand anytime-ready test — ~2 hr (uncomment to use)
# ARENA_COMPETITION_ID=cmpkdus9200syw8do5644oymp

# ─── LLM keys (for Level 5 / pokerkit llm) ────────────────────────────────────
# Set your Anthropic key here to enable Claude-powered decisions:
ANTHROPIC_API_KEY=

# Or OpenAI / OpenRouter (fallback if no Anthropic key):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # for OpenRouter
